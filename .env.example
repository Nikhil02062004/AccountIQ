# AccountIQ Configuration

# Database
DATABASE_URL=sqlite:///./accountiq.db

# Optional LLM API Key (Zero-Cost / No-Key Mode runs out-of-the-box using DeterministicProvider)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Privacy & Data Retention (GDPR & PDPA Compliance)
DATA_RETENTION_DAYS=90
ALLOW_CONTACT_DELETION=true

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
