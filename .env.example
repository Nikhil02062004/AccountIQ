# ==============================================================================
# AccountIQ — Enterprise Account & Contact Intelligence Platform for Zscaler
# Environment Configuration Template
# ==============================================================================
#
# NOTE: AccountIQ is designed to run 100% OUT-OF-THE-BOX with ZERO PAID API KEYS.
# All entity resolution, live web discovery (Wikipedia, Wikidata, SEC EDGAR, DuckDuckGo),
# fact extraction, and heuristic scoring work completely free of charge.
#
# To customize or supply optional LLM keys, copy this file:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# In Docker Compose, the persistent volume mounts at /app/data:
#   DATABASE_URL=sqlite:////app/data/accountiq.db
# When running locally outside Docker:
DATABASE_URL=sqlite:///./accountiq.db

# ------------------------------------------------------------------------------
# 2. Frontend / Client Configuration
# ------------------------------------------------------------------------------
# Client-side API endpoint for the browser to communicate with the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
PORT=3000

# ------------------------------------------------------------------------------
# 3. Optional LLM Integration (Zero-Cost / No-Key Mode runs by default)
# ------------------------------------------------------------------------------
# If left blank, AccountIQ automatically uses its built-in DeterministicProvider
# and rule-based heuristic extraction pipeline. Zero paid API keys are required.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Privacy, Data Retention & Compliance (GDPR Art. 17 & PDPA)
# ------------------------------------------------------------------------------
DATA_RETENTION_DAYS=90
ALLOW_CONTACT_DELETION=true

# ------------------------------------------------------------------------------
# 5. Server Ports (Default host port bindings)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
